/**
 * Quorum Worker config.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Gotcha #1 (paid for in real time): migrations MUST use
 * `new_sqlite_classes`, NOT `new_classes`. Wrong tag silently
 * gives a legacy KV-backed DO with no `this.sql`.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quorum",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-02",
  "compatibility_flags": ["nodejs_compat"],
  // Inline markdown prompt files (quorum/prompts/*.md) as string modules.
  // The TS ambient declaration lives at src/md-modules.d.ts.
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ],
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "DEFAULT_BOARD_CHAT": "-5224131572",
    "PUBLIC_BASE_URL": "https://quorum.joao-f-o-goncalves.workers.dev",
    // Comma-separated GitHub logins (lowercase). Members of this list can
    // edit ideas via the board UI. Anyone authed (in or out of list) can vote.
    // Whitespace around commas is stripped at compare time.
    "EDITOR_WHITELIST": "molefas,muffles,joao-f-o-goncalves,twody7"
  },
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/webhook", "/healthz", "/api/*", "/auth/*", "/g/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "QuorumAgent",
        "name": "QuorumAgent"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["QuorumAgent"],
      "tag": "v1"
    }
  ],
  "observability": {
    "enabled": true
  }
}

/**
 * Quorum Worker config.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Gotcha #1 (paid for in real time): migrations MUST use
 * `new_sqlite_classes`, NOT `new_classes`. Wrong tag silently
 * gives a legacy KV-backed DO with no `this.sql`.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quorum",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-02",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "DEFAULT_BOARD_CHAT": "-5120669057",
    "PUBLIC_BASE_URL": "https://quorum.joao-f-o-goncalves.workers.dev"
  },
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/webhook", "/healthz", "/api/*", "/g/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "QuorumAgent",
        "name": "QuorumAgent"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["QuorumAgent"],
      "tag": "v1"
    }
  ],
  "observability": {
    "enabled": true
  }
}
